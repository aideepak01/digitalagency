# Copy to .env.local for development. Never commit real credentials.

# ---------------------------------------------------------------- database
# External managed Postgres (Neon, Supabase, or your own). Required in
# production. When unset, content queries return empty results and every form
# submission fails — the build still succeeds, which is what lets CI run.
DATABASE_URL="postgresql://user:password@host:5432/sbabuai?sslmode=require"
# Hostinger runs few app instances; keep the pool small.
DATABASE_POOL_MAX="5"

# ------------------------------------------------------------------- admin
# Random string, 32+ characters. Signs the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ------------------------------------------------------------------- email
# Hostinger SMTP, using the mailboxes the site already advertises.
# Without these the site still records submissions, but sends no mail.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="sbabu@sbabuai.com"
SMTP_PASSWORD=""
SMTP_FROM="Sbabu AI <sbabu@sbabuai.com>"
# Where form notifications go. Defaults to the sales email in site settings.
NOTIFICATION_EMAIL="sales@sbabuai.com"

# ----------------------------------------------------------------- uploads
# ABSOLUTE path OUTSIDE the repository. The Hostinger deploy pulls and rebuilds
# in place, so anything inside the project tree (including public/) can be wiped
# by the next push.
UPLOAD_DIR="/home/USER/sbabuai-uploads"
MAX_UPLOAD_BYTES="5242880"

# ------------------------------------------------------------ abuse control
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_SECONDS="3600"
# Salt for hashing submitter IPs before storing them.
IP_HASH_SALT=""

# -------------------------------------------------------------- fallbacks
# Used for metadataBase only when the database is unreachable.
NEXT_PUBLIC_SITE_URL="https://sbabuai.com"
